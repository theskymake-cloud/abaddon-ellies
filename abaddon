do
    local circ = new("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, Visible = false, ZIndex = 3, Active = false,
    }, M.layer)
    new("UICorner", { CornerRadius = UDim.new(1, 0) }, circ)
    new("UIStroke", { Color = C.White, Thickness = 1, Transparency = 0.2 }, circ)

    local lock, trigAt, lastTrig = nil, nil, 0
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude

    local function legitStep(dt)
        local c = M.cam()
        if not c then return end
        local mouse = c.ViewportSize / 2   -- в шутере курсор залочен, GetMouseLocation даёт мусор
        circ.Visible = State.LegitOn and State.LegitDraw and not open
        if circ.Visible then
            circ.Size = UDim2.fromOffset(State.LegitFOV * 2, State.LegitFOV * 2)
            circ.Position = UDim2.fromOffset(mouse.X, mouse.Y)
        end
        if open or UIS:GetFocusedTextBox() then return end

        if State.LegitOn and M.keyHeld(State.LegitKey) then
            local t
            if State.LegitSticky and lock and lock.part.Parent and (M.charParts(lock.plr)) then t = lock else lock = nil end
            if not t then
                t = M.findTarget({
                    fov = State.LegitFOV, hitbox = State.LegitBone, sort = "Closest FOV",
                    visible = State.LegitVisible, ref = mouse,
                })
                if State.LegitSticky then lock = t end
            end
            if t then
                local pos = t.part.Position
                if State.LegitPredict then pos += t.part.AssemblyLinearVelocity * math.clamp(t.dist / 900, 0.03, 0.25) end
                local alpha = math.clamp((100 - State.LegitSmooth) / 100, 0.02, 1)
                alpha = 1 - (1 - alpha) ^ (dt * 60)
                c.CFrame = c.CFrame:Lerp(CFrame.lookAt(c.CFrame.Position, pos), alpha)
            end
        else
            lock = nil
        end

        if State.Trigger then
            local ray = c:ViewportPointToRay(mouse.X, mouse.Y)
            rp.FilterDescendantsInstances = M.ignoreList()
            local res = workspace:Raycast(ray.Origin, ray.Direction * 2000, rp)
            local hit = false
            if res then
                local plr = M.plrFromInstance(res.Instance)
                hit = plr ~= nil and M.isEnemy(plr) and (M.charParts(plr)) ~= nil
            end
            local now = os.clock()
            if hit then
                trigAt = trigAt or now
                if now - trigAt >= State.TriggerDelay / 1000 and now - lastTrig >= 0.05 then
                    lastTrig = now
                    M.shoot()
                end
            else
                trigAt = nil
            end
        end
    end
    pcall(function()
        RunService:BindToRenderStep("AbaddonLegit", Enum.RenderPriority.Camera.Value + 1, function(dt)
            local ok, err = pcall(legitStep, dt)
            if not ok then reportErr("legit", err) end
        end)
    end)
    onCleanup(function() pcall(function() RunService:UnbindFromRenderStep("AbaddonLegit") end) end)
end

