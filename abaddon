do -- jump bug: прыжок той же силы, но горизонтальная скорость в воздухе растёт с каждым прыжком
    local boost, wasGround, gt = 0, true, 0
    hook(RunService.Heartbeat, function(dt)
        if not (State.JumpBug or State.AutoHop) then boost = 0 return end
        local ch, hum, root = M.charParts(LP)
        if not ch or hum.Sit or State.Fly or open or UIS:GetFocusedTextBox() then return end
        local grounded = hum.FloorMaterial ~= Enum.Material.Air
        local space = UIS:IsKeyDown(Enum.KeyCode.Space)
        if State.AutoHop and space and grounded then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
        local v = root.AssemblyLinearVelocity
        if wasGround and not grounded and v.Y > 5 and State.JumpBug then
            boost = math.min(State.JBMax, boost + State.JBGain)
        end
        if grounded then gt += dt else gt = 0 end
        if gt > 0.3 and not space then boost = 0 end
        if State.JumpBug and not grounded and boost > 0 then
            local md = hum.MoveDirection
            if md.Magnitude > 0.05 then
                local hv = md.Unit * (hum.WalkSpeed + boost)
                root.AssemblyLinearVelocity = Vector3.new(hv.X, v.Y, hv.Z)
            end
        end
        wasGround = grounded
    end)
end

do -- speed
    hook(RunService.Heartbeat, function(dt)
        if not State.SpeedOn or State.Fly then return end
        local ch, hum, root = M.charParts(LP)
        if not ch then return end
        local md = hum.MoveDirection
        if md.Magnitude > 0.05 then root.CFrame = root.CFrame + md.Unit * State.Speed * dt end
    end)
end

do -- noclip
    local touched = setmetatable({}, { __mode = "k" })
    hook(RunService.Stepped, function()
        if State.Noclip then
            local ch = LP.Character
            if ch then
                for _, p in ipairs(ch:GetDescendants()) do
                    if p:IsA("BasePart") and p.CanCollide then touched[p] = true p.CanCollide = false end
                end
            end
        elseif next(touched) then
            for p in pairs(touched) do touched[p] = nil if p.Parent then p.CanCollide = true end end
        end
    end)
end

do -- fly
    local bv
    hook(RunService.RenderStepped, function()
        local ch, hum, root = M.charParts(LP)
        local c = M.cam()
        if State.Fly and ch and c then
            if not bv or bv.Parent ~= root then
                if bv then bv:Destroy() end
                bv = new("BodyVelocity", { MaxForce = Vector3.new(1e6, 1e6, 1e6), Velocity = Vector3.zero }, root)
            end
            local mv = Vector3.zero
            if not UIS:GetFocusedTextBox() then
                if UIS:IsKeyDown(Enum.KeyCode.W) then mv += c.CFrame.LookVector end
                if UIS:IsKeyDown(Enum.KeyCode.S) then mv -= c.CFrame.LookVector end
                if UIS:IsKeyDown(Enum.KeyCode.A) then mv -= c.CFrame.RightVector end
                if UIS:IsKeyDown(Enum.KeyCode.D) then mv += c.CFrame.RightVector end
                if UIS:IsKeyDown(Enum.KeyCode.Space) then mv += Vector3.new(0, 1, 0) end
                if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then mv -= Vector3.new(0, 1, 0) end
            end
            bv.Velocity = mv.Magnitude > 0 and mv.Unit * State.FlySpeed or Vector3.zero
        elseif bv then
            bv:Destroy()
            bv = nil
        end
    end)
    onCleanup(function() if bv then pcall(function() bv:Destroy() end) end end)
end

