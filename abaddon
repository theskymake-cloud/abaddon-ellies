-- LEGIT: ESP / wallhack (рамки на Frame + Highlight)
----------------------------------------------------------------------
do
    local layer = new("Frame", { Name = "ESPLayer", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 2, Active = false }, ScreenGui)
    local objs = {}
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude

    local function thick(p, col, th)
        return new("UIStroke", { Color = col, Thickness = th, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, p)
    end
    local function mk()
        local o = {}
        o.outline = new("Frame", { BackgroundTransparency = 1, Visible = false, ZIndex = 2, Active = false }, layer)
        thick(o.outline, C.Black, 3)
        o.box = new("Frame", { BackgroundTransparency = 1, Visible = false, ZIndex = 3, Active = false }, layer)
        o.stroke = thick(o.box, C.White, 1)
        o.name = new("TextLabel", {
            Size = UDim2.fromOffset(160, 12), AnchorPoint = Vector2.new(0.5, 1), BackgroundTransparency = 1, Font = FONT,
            TextSize = 11, TextColor3 = C.White, TextStrokeTransparency = 0.4, Visible = false, ZIndex = 4, Active = false,
        }, layer)
        o.info = new("TextLabel", {
            Size = UDim2.fromOffset(160, 12), AnchorPoint = Vector2.new(0.5, 0), BackgroundTransparency = 1, Font = FONT,
            TextSize = 10, TextColor3 = C.Text, TextStrokeTransparency = 0.4, Visible = false, ZIndex = 4, Active = false,
        }, layer)
        o.hpBg = new("Frame", { BackgroundColor3 = C.Black, BorderSizePixel = 0, Visible = false, ZIndex = 2, Active = false }, layer)
        o.hp = new("Frame", { BorderSizePixel = 0, ZIndex = 3, Active = false }, o.hpBg)
        o.line = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), BorderSizePixel = 0, Visible = false, ZIndex = 2, Active = false }, layer)
        return o
    end
    local function hide(o)
        o.outline.Visible, o.box.Visible, o.name.Visible, o.info.Visible, o.hpBg.Visible, o.line.Visible = false, false, false, false, false, false
        if o.hl then o.hl.Enabled = false end
    end
    local function kill(o)
        for _, k in ipairs({ "outline", "box", "name", "info", "hpBg", "line", "hl" }) do
            if o[k] then pcall(function() o[k]:Destroy() end) end
        end
    end
    hook(Players.PlayerRemoving, function(p) if objs[p] then kill(objs[p]) objs[p] = nil end end)
    onCleanup(function() for _, o in pairs(objs) do kill(o) end pcall(function() layer:Destroy() end) end)

    local HL_CAP = 15

    local function draw(plr, c, vs, col, hlOk)
        local ch, hum, root = M.charParts(plr)
        if not ch then return false end
        local head = ch:FindFirstChild("Head")
        local dist = (root.Position - c.CFrame.Position).Magnitude
        if dist > State.ESPMax then return false end
        if State.ESPVisOnly and head and not M.visible(head, ch) then return false end

        local o = objs[plr]
        if not o then o = mk() objs[plr] = o end

        local tp = c:WorldToViewportPoint((head and head.Position or root.Position) + Vector3.new(0, 0.7, 0))
        local bp = c:WorldToViewportPoint(root.Position - Vector3.new(0, 3.1, 0))
        if tp.Z > 0 and bp.Z > 0 then
            local h = math.abs(bp.Y - tp.Y)
            local w = h * 0.55
            local cx, y0 = (tp.X + bp.X) / 2, math.min(tp.Y, bp.Y)
            local x0 = cx - w / 2
            o.outline.Visible, o.box.Visible = State.ESPBox, State.ESPBox
            o.outline.Position, o.box.Position = UDim2.fromOffset(x0, y0), UDim2.fromOffset(x0, y0)
            o.outline.Size, o.box.Size = UDim2.fromOffset(w, h), UDim2.fromOffset(w, h)
            o.stroke.Color = col
            o.name.Visible = State.ESPName
            o.name.Text = plr.DisplayName
            o.name.Position = UDim2.fromOffset(cx, y0 - 2)
            o.info.Visible = State.ESPDist
            o.info.Text = math.floor(dist) .. "m"
            o.info.Position = UDim2.fromOffset(cx, y0 + h + 2)
            o.hpBg.Visible = State.ESPHealth
            o.hpBg.Position = UDim2.fromOffset(x0 - 5, y0 - 1)
            o.hpBg.Size = UDim2.fromOffset(3, h + 2)
            local frac = math.clamp(hum.Health / math.max(1, hum.MaxHealth), 0, 1)
            o.hp.AnchorPoint = Vector2.new(0, 1)
            o.hp.Position = UDim2.new(0, 1, 1, -1)
            o.hp.Size = UDim2.new(1, -2, frac, -2)
            o.hp.BackgroundColor3 = Color3.fromHSV(frac * 0.33, 1, 1)
            if State.ESPTracers then
                local ox, oy = vs.X / 2, vs.Y
                local dx, dy = cx - ox, (y0 + h) - oy
                o.line.Visible = true
                o.line.BackgroundColor3 = col
                o.line.Size = UDim2.fromOffset(math.sqrt(dx * dx + dy * dy), 1)
                o.line.Position = UDim2.fromOffset((ox + cx) / 2, (oy + y0 + h) / 2)
                o.line.Rotation = math.deg(math.atan2(dy, dx))
            else
                o.line.Visible = false
            end
        else
            o.outline.Visible, o.box.Visible, o.name.Visible, o.info.Visible, o.hpBg.Visible, o.line.Visible = false, false, false, false, false, false
        end

        local usedHl = false
        if State.ESPChams and hlOk then
            if not o.hl or not o.hl.Parent then
                if o.hl then pcall(function() o.hl:Destroy() end) end
                o.hl = new("Highlight", { Name = "AbaddonHL" }, ScreenGui)
            end
            o.hl.Enabled = true
            o.hl.Adornee = ch
            o.hl.FillColor, o.hl.OutlineColor = col, col
            o.hl.FillTransparency = State.ESPFill / 100
            o.hl.OutlineTransparency = 0
            o.hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            usedHl = true
        elseif o.hl then
            o.hl.Enabled = false
        end
        return usedHl and "hl" or true
    end

    hook(RunService.RenderStepped, function()
        local c = M.cam()
        local used = {}
        if State.ESP and c then
            local vs = c.ViewportSize
            local col = colorOf(State.ESPColor)
            local list = {}
            for _, plr in ipairs(Players:GetPlayers()) do
                if M.isEnemy(plr) then
                    local r = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
                    list[#list + 1] = { plr = plr, d = r and (r.Position - c.CFrame.Position).Magnitude or 1e9 }
                end
            end
            table.sort(list, function(a, b) return a.d < b.d end)
            local hlN = 0
            for _, e in ipairs(list) do
                local ok, res = pcall(draw, e.plr, c, vs, col, hlN < HL_CAP)
                if ok then
                    if res then
                        used[e.plr] = true
                        if res == "hl" then hlN += 1 end
                    end
                else
                    reportErr("esp", res)
                end
            end
        end
        for plr, o in pairs(objs) do if not used[plr] then hide(o) end end
    end)
end

