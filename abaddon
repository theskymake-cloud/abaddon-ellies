            emit.Color = ColorSequence.new(C.White)
            emit.Transparency = NumberSequence.new(0.2)
            emit.LightEmission = 0.3
            emit.Orientation = Enum.ParticleOrientation.FacingCamera
            emit.RotSpeed = NumberRange.new(-40, 40)
        else
