do
    M.layer = new("Frame", { Name = "Layer", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 2, Active = false }, ScreenGui)

    function M.cam() return workspace.CurrentCamera end

    function M.charParts(plr)
        local ch = plr.Character
        if not ch then return end
        local hum = ch:FindFirstChildOfClass("Humanoid")
        if not hum then return end
        local root = ch:FindFirstChild("HumanoidRootPart") or hum.RootPart or ch.PrimaryPart
        if root and hum.Health > 0 then return ch, hum, root end
    end

    -- тимчек работает только если в игре реально есть 2+ команды
    -- (раньше при одной общей команде все игроки считались союзниками -> ни WH, ни рейдж)
    local multi, teamT = 0, 0
    -- сколько команд с 2+ игроками (в FFA с одной командой + наблюдателями будет < 2)
    function M.teamsInUse()
        if os.clock() - teamT > 1 then
            teamT = os.clock()
            local counts = {}
            for _, p in ipairs(Players:GetPlayers()) do
                local t = p.Team
                if t then counts[t] = (counts[t] or 0) + 1 end
            end
            multi = 0
            for _, n in pairs(counts) do if n >= 2 then multi += 1 end end
        end
        return multi
    end

    function M.isEnemy(plr)
        if plr == LP then return false end
        if State.TeamMode == "On" then
            local lt = LP.Team
            return not (lt and plr.Team == lt)
        end
        return true
    end

    function M.plrFromInstance(inst)
        local m = inst
        while m and m ~= workspace do
            if m:IsA("Model") then
                local p = Players:GetPlayerFromCharacter(m)
                if p then return p end
            end
            m = m.Parent
        end
    end

    -- части тела ищем и по точным именам (R6/R15), и по подстроке в имени
    local function findPart(ch, exact, hint)
        for _, n in ipairs(exact) do
            local p = ch:FindFirstChild(n)
            if p and p:IsA("BasePart") then return p end
        end
        for _, p in ipairs(ch:GetChildren()) do
            if p:IsA("BasePart") and p.Name:lower():find(hint, 1, true) then return p end
        end
    end
    local HEAD_N  = { "Head" }
    local TORSO_N = { "UpperTorso", "Torso", "LowerTorso" }

    -- все видимые части, лежащие прямо в модели (без аксессуаров), любые имена
    function M.bodyParts(ch)
        local list = {}
        for _, p in ipairs(ch:GetChildren()) do
            if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" and p.Transparency < 1 then
                list[#list + 1] = p
            end
        end
        return list
    end

    function M.pickPart(ch, mode, ref)
        local root = ch:FindFirstChild("HumanoidRootPart") or ch.PrimaryPart
        if mode == "Head" then
            return findPart(ch, HEAD_N, "head") or findPart(ch, TORSO_N, "torso") or root
        end
        if mode == "Torso" then return findPart(ch, TORSO_N, "torso") or root end
        if mode == "Root" then return root end
        local list = M.bodyParts(ch)
        if #list == 0 then return root end
        if mode == "Random" then return list[math.random(#list)] end
        local c = M.cam()
        local best, bd
        for _, p in ipairs(list) do
            local sp = c:WorldToViewportPoint(p.Position)
            if sp.Z > 0 then
                local d = (Vector2.new(sp.X, sp.Y) - ref).Magnitude
                if not bd or d < bd then best, bd = p, d end
            end
        end
        return best or root
    end

    local rp = RaycastParams.new()

    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    rp.IgnoreWater = true
    function M.ignoreList(extra)
        local ign = { M.cam() }
        if LP.Character then ign[#ign + 1] = LP.Character end
        local bs = workspace:FindFirstChild("bulletStorage")
        if bs then ign[#ign + 1] = bs end
        if extra then ign[#ign + 1] = extra end
        return ign
    end
    function M.visible(part, ch)
        local c = M.cam()
        if not c then return false end
        rp.FilterDescendantsInstances = M.ignoreList()
        local o = c.CFrame.Position
        local res = workspace:Raycast(o, part.Position - o, rp)
        return res == nil or res.Instance:IsDescendantOf(ch)
    end

    -- o: fov, hitbox, sort, visible, ref(Vector2), skipFF
    -- o: fov, hitbox, sort, visible, ref(Vector2), skipFF, all (360: без FOV и без проверки "перед камерой")
    function M.findTarget(o)
        local c = M.cam()
        if not c then return end
        local look = c.CFrame.LookVector
        local best, bs
        for _, plr in ipairs(Players:GetPlayers()) do
            if M.isEnemy(plr) then
                local ch, hum, root = M.charParts(plr)
                if ch and not (o.skipFF and ch:FindFirstChildOfClass("ForceField")) then
                    local part = M.pickPart(ch, o.hitbox, o.ref)
                    if part then
                        local sp = c:WorldToViewportPoint(part.Position)
                        local d2 = (Vector2.new(sp.X, sp.Y) - o.ref).Magnitude
                        if (o.all or (sp.Z > 0 and d2 <= o.fov)) and (not o.visible or M.visible(part, ch)) then
                            local off = part.Position - c.CFrame.Position
                            local dist = off.Magnitude
                            local score = d2
                            if o.all then
                                score = dist > 0.01 and math.deg(math.acos(math.clamp(look:Dot(off.Unit), -1, 1))) or 0
                            end
                            if o.sort == "Closest Distance" then score = dist
                            elseif o.sort == "Lowest Health" then score = hum.Health
                            elseif o.sort == "Highest Health" then score = -hum.Health end
                            if not bs or score < bs then
                                best, bs = { plr = plr, ch = ch, hum = hum, root = root, part = part, dist = dist }, score
                            end
                        end
                    end
                end
            end
        end
        return best
    end

    function M.keyHeld(name)
        if name == "Always" then return true end
        if name == "RMB" then return UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) end
        if name == "LMB" then return UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) end
        if name == "MB3" then return UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton3) end
        local ok, kc = pcall(function() return Enum.KeyCode[name] end)
        return ok and kc ~= nil and UIS:IsKeyDown(kc)
    end

    -- стрельба через игровой SignalManager (так же, как ContextAction игры)
    function M.fireWeapon(state)
        local method = State.RageFire
        if M.SM and method ~= "Click" then pcall(M.SM.Fire, "FireWeapon", state) return end
        local c = M.cam()
        if not c then return end
        local vs = c.ViewportSize
        pcall(function()
            game:GetService("VirtualInputManager"):SendMouseButtonEvent(vs.X / 2, vs.Y / 2, 0, state == Enum.UserInputState.Begin, game, 0)
        end)
    end
    function M.shoot()
        M.fireWeapon(Enum.UserInputState.Begin)
        task.delay(0.03, function() M.fireWeapon(Enum.UserInputState.End) end)
    end
end

----------------------------------------------------------------------
-- RAGE: цель, auto-fire, silent (патч Cast), camera-режим, hitbox expander
----------------------------------------------------------------------
do
    M.rageT, M.rageTime = nil, 0
    local lastFire, lastSeen, lastReload = 0, 0, 0

    hook(RunService.Heartbeat, function()
        if not State.RageOn or open then M.rageT = nil return end
        local c = M.cam()
        if not c then return end
        local t = M.findTarget({
            fov = State.RageFOV, hitbox = State.RageHitbox, sort = State.RageTarget,
            visible = State.RageVisible, ref = c.ViewportSize / 2, skipFF = State.RageSkipFF, all = State.Rage360,
        })
        local now = os.clock()
        M.rageT, M.rageTime = t, now
        if t then
            lastSeen = now
            if State.RageAutoFire and now - lastFire >= math.max(State.RageDelay / 1000, 0.05) then
                lastFire = now
                M.shoot()
            end
        elseif State.RageAutoReload and now - lastSeen > 0.8 and now - lastReload > 2.5 and M.SM then
            lastReload = now
            pcall(M.SM.Fire, "ReloadWeapon")
        end
    end)

    pcall(function()
        RunService:BindToRenderStep("AbaddonRageCam", Enum.RenderPriority.Camera.Value + 1, function()
            pcall(function()
                if not State.RageOn or open then return end
                if State.RageMode == "Silent" and M.silentOk then return end   -- патч не встал -> целимся камерой
                local t = M.rageT
                
                if not t or os.clock() - M.rageTime > 0.2 or not t.part.Parent then return end
                local c = M.cam()
                local pos = t.part.Position
                if State.RagePredict then pos += t.part.AssemblyLinearVelocity * 0.06 end
                c.CFrame = CFrame.lookAt(c.CFrame.Position, pos)
            end)
        end)
    end)
    onCleanup(function() pcall(function() RunService:UnbindFromRenderStep("AbaddonRageCam") end) end)

    -- silent aim: патчим Cast у модуля снарядов. Подменяется точка прицеливания (с учётом
    -- гравитации, ветра, скорости пули и движения цели), всё остальное делает сама игра.
    local patched, searching, mod, orig = false, false, nil, nil
    local PRI = { "cast", "bullet", "proj", "ray", "ballist", "gun", "weapon" }
    local function prio(m)
        local n = m.Name:lower()
        for i, k in ipairs(PRI) do if n:find(k, 1, true) then return i end end
        return 99
    end
    local function search()
        local pool = {}
        if getloadedmodules then
            pcall(function() for _, m in ipairs(getloadedmodules()) do pool[#pool + 1] = m end end)
        end
        if #pool == 0 then
            for _, root in ipairs({ RS, LP:FindFirstChild("PlayerScripts"), LP:FindFirstChild("PlayerGui"), game:GetService("ReplicatedFirst") }) do
                if root then
                    for _, d in ipairs(root:GetDescendants()) do
                        if d:IsA("ModuleScript") then pool[#pool + 1] = d end
                    end
                end
            end
        end
        table.sort(pool, function(a, b) return prio(a) < prio(b) end)
        for _, m in ipairs(pool) do
            if m:IsA("ModuleScript") and not m:GetFullName():find("^CoreGui") then
                local ok, t = pcall(require, m)
                if ok and type(t) == "table" and type(rawget(t, "Cast")) == "function" and type(rawget(t, "new")) == "function" then
                    return t, m
                end
            end
        end
    end

        -- точка, в которую нужно стрелять: скорость пули, гравитация, ветер, движение цели
    function M.solve(origin, t, spd, g, w)
        local a = Vector3.new(w.X, -g * workspace.Gravity, w.Z)
        local vel = State.RagePredict and t.part.AssemblyLinearVelocity or Vector3.zero
        local T = t.part.Position
        local tt = (T - origin).Magnitude / spd
        for _ = 1, 4 do
            local d = (T + vel * tt) - origin - a * (0.5 * tt * tt)
            tt = d.Magnitude / spd
        end
        local d = (T + vel * tt) - origin - a * (0.5 * tt * tt)
        if d.Magnitude < 0.05 then return nil end
        return origin + d
    end

    function M.currentTarget()
        local t = M.rageT
        if t and os.clock() - M.rageTime <= 0.25 and t.part.Parent then return t end
        local c = M.cam()
        if not c then return end
        return M.findTarget({
            fov = State.RageFOV, hitbox = State.RageHitbox, sort = State.RageTarget,
            visible = State.RageVisible, ref = c.ViewportSize / 2, skipFF = State.RageSkipFF, all = State.Rage360,
        })
    end

    function M.redirect(self, origin, target, speed)
        if not (State.RageOn and State.RageMode ~= "Camera") then return end
        if typeof(origin) ~= "Vector3" or type(speed) ~= "number" or speed <= 0 then return end
        local ch, _, root = M.charParts(LP)
        if not ch or (origin - root.Position).Magnitude > 16 then return end   -- только наши выстрелы
        local t = M.currentTarget()
        if not t then return end
        local spd = speed * 20.224489795918366
        local g = type(self.Gravity) == "number" and self.Gravity or 0
        local w = typeof(self.Wind) == "Vector3" and self.Wind or Vector3.zero
        M.lastCast = { spd = spd, g = g, w = w, time = os.clock() }
        return M.solve(origin, t, spd, g, w)
    end

    -- переписывает аргументы fire-ремоутов, чтобы сервер видел тот же выстрел, что и клиентский снаряд.
    -- ищет векторы, совпадающие с исходным направлением взгляда (точка, направление или скорость*направление)
    function M.rewriteArgs(a)
        local c = M.cam()
        local ch, _, root = M.charParts(LP)
        if not (c and ch) then return false end
        local t = M.currentTarget()
        if not t then return false end
        local look = c.CFrame.LookVector

        local origin
        for i = 1, a.n do
            local v = a[i]
            if typeof(v) == "Vector3" and v.Magnitude > 1.5 and (v - root.Position).Magnitude < 16 then origin = v break end
        end
        origin = origin or (root.Position + Vector3.new(0, 1.5, 0))

        local lc = M.lastCast
        local fresh = lc and os.clock() - lc.time < 10
        local tp = M.solve(origin, t, fresh and lc.spd or 1e5, fresh and lc.g or 0, fresh and lc.w or Vector3.zero)
        if not tp then return false end
        local newDir = (tp - origin).Unit

        local changed = false
        for i = 1, a.n do
            local v = a[i]
            local tv = typeof(v)
            if tv == "Vector3" then
                local m = v.Magnitude
                local d = v - origin
                if d.Magnitude > 3 and d.Unit:Dot(look) > 0.97 and (v - root.Position).Magnitude > 16 then
                    a[i], changed = tp, true                    -- точка прицеливания
                elseif m > 0.2 and (v / m):Dot(look) > 0.97 then
                    a[i], changed = newDir * m, true            -- направление (единичное или с множителем скорости)
                end
            elseif tv == "CFrame" then
                if v.LookVector:Dot(look) > 0.97 then
                    a[i], changed = CFrame.lookAt(v.Position, v.Position + newDir), true
                end
            end
        end
        return changed
    end

    function M.ensureSilent()
        if patched or searching then return end
        if not (State.RageOn and State.RageMode ~= "Camera") then return end
        searching = true
        task.spawn(function()
            local t, m = search()
            searching = false
            if not t then logWarn("Silent: module not found, using camera aim instead") return end
            local old = t.Cast
            mod, orig = t, old
            t.Cast = function(self, p6, origin, target, speed)
                if alive then
                    local ok, nt = pcall(M.redirect, self, origin, target, speed)
                    if ok and nt then target = nt end
                end
                return old(self, p6, origin, target, speed)
            end
            patched = true
            M.silentOk = true
            logOk("Silent: patched " .. m.Name)
        end)
    end
    onCleanup(function() if patched and mod and orig then pcall(function() mod.Cast = orig end) end end)

    -- hitbox expander (клиентский рейкаст пули будет попадать в увеличенные части)
    local saved = {}
    local function restoreOne(p)
        local s = saved[p]
        saved[p] = nil
        if s and p.Parent then pcall(function() p.Size, p.Transparency, p.CanCollide = s.Size, s.Transparency, s.CanCollide end) end
    end
    local function restoreAll() for p in pairs(saved) do restoreOne(p) end end
    onCleanup(restoreAll)
    every(0.2, function()
        if not (State.RageOn and State.RageHB) then
            if next(saved) then restoreAll() end
            return
        end
        local sz, seen = State.RageHBSize, {}
        for _, plr in ipairs(Players:GetPlayers()) do
            if M.isEnemy(plr) and plr.Character then
                for _, p in ipairs({ M.pickPart(plr.Character, "Head"), M.pickPart(plr.Character, "Root") }) do
                    if p then
                        seen[p] = true
                        if not saved[p] then saved[p] = { Size = p.Size, Transparency = p.Transparency, CanCollide = p.CanCollide } end
                        p.Size = Vector3.new(sz, sz, sz)
                        p.Transparency = 0.8
                        p.CanCollide = false
                    end
                end
            end
        end
        for p in pairs(saved) do if not seen[p] then restoreOne(p) end end
    end)
end

----------------------------------------------------------------------
-- RAGE: anti-aim (R6), fake lag, third person
----------------------------------------------------------------------
do
    local ang, lastFlip, flip, lastRand, rnd = 0, 0, 1, 0, 0
    local rj, rjC0
    local wasOn = false
    local function restore()
        if rj and rj.Parent and rjC0 then rj.C0 = rjC0 end
        rj, rjC0 = nil, nil
        local _, hum = M.charParts(LP)
        if hum then hum.AutoRotate = true end
    end
    onCleanup(restore)

    hook(RunService.Heartbeat, function(dt)
        if not State.AAOn then
            if wasOn then wasOn = false restore() end
            return
        end
        wasOn = true
        local ch, hum, root = M.charParts(LP)
        local c = M.cam()
        if not ch or not c then return end
        hum.AutoRotate = false
        local now = os.clock()
        local look = c.CFrame.LookVector
        local base = math.atan2(-look.X, -look.Z)
        if now - lastFlip > 0.07 then lastFlip, flip = now, -flip end
        local mode, yaw = State.AAMode, 0
        if mode == "Spin" then
            ang += math.rad(State.AASpeed) * dt * 60
            yaw = ang
        elseif mode == "Spin + Jitter" then
            ang += math.rad(State.AASpeed) * dt * 60
            yaw = ang + math.rad(State.AAJitter) * flip
        elseif mode == "Jitter" then
            yaw = base + math.pi + math.rad(State.AAJitter) * flip
        elseif mode == "Backward" then
            yaw = base + math.pi
        elseif mode == "Sideways" then
            yaw = base + (math.floor(now / 0.5) % 2 == 0 and 1 or -1) * math.pi / 2
        else
            if now - lastRand > 0.03 then lastRand, rnd = now, math.random() * math.pi * 2 end
            yaw = rnd
        end
        root.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, yaw, 0)
        root.AssemblyAngularVelocity = Vector3.zero

        -- pitch: наклон торса через RootJoint (R6)
        local pm = State.AAPitch
        local j = ch:FindFirstChild("RootJoint", true)
        if pm ~= "None" and j and j:IsA("Motor6D") then
            if rj ~= j then rj, rjC0 = j, j.C0 end
            local p
            if pm == "Down" then p = -75
            elseif pm == "Up" then p = 75
            elseif pm == "Jitter" then p = 70 * flip
            else p = (now * 600) % 360 end
            j.C0 = rjC0 * CFrame.Angles(math.rad(p), 0, 0)
        elseif rj then
            if rj.Parent and rjC0 then rj.C0 = rjC0 end
            rj, rjC0 = nil, nil
        end
    end)
end

do
    local token = 0
    local function lim(v)
        return (pcall(function() game:GetService("NetworkClient"):SetOutgoingKBPSLimit(v) end))
    end
    function M.setFakeLag(on)
        token += 1
        local my = token
        if not on then lim(math.huge) return end
        task.spawn(function()
            while alive and State.FakeLag and token == my do
                if not lim(1) then
                    logWarn("Fake lag: not supported by this executor")
                    if Reg.FakeLag then Reg.FakeLag(false) end
                    break
                end
                task.wait(math.max(State.FakeLagOn, 20) / 1000)
                lim(math.huge)
                task.wait(math.max(State.FakeLagOff, 20) / 1000)
            end
            if token == my then lim(math.huge) end
        end)
    end
    onCleanup(function() token += 1 lim(math.huge) end)
end

