----------------------------------------------------------------------
-- SETTINGS: menu key, blur, config, unload
----------------------------------------------------------------------
do
    local blur = new("BlurEffect", { Name = "AbaddonBlur", Size = 0 }, Lighting)
    onCleanup(function() pcall(function() blur:Destroy() end) end)

    local function setMenu(v)
        if open == v then return end
        open = v
        if v then
            Panel.Visible, Overlay.Visible = true, true
            tween(Panel, 0.2, { GroupTransparency = 0 })
            tween(Overlay, 0.2, { BackgroundTransparency = 0.55 })
            tween(blur, 0.25, { Size = State.Blur and 14 or 0 })
        else
            if closeOpenDD then pcall(closeOpenDD) end
            tween(Panel, 0.15, { GroupTransparency = 1 })
            tween(Overlay, 0.15, { BackgroundTransparency = 1 })
            tween(blur, 0.2, { Size = 0 })
            task.delay(0.17, function()
                if not open then Panel.Visible, Overlay.Visible = false, false end
            end)
        end
    end
    M.setMenu = setMenu
    CloseBtn.MouseButton1Click:Connect(function() setMenu(false) end)

    M.listening = false
    hook(UIS.InputBegan, function(i, gp)
        if M.listening then
            if i.UserInputType == Enum.UserInputType.Keyboard then
                M.listening = false
                if i.KeyCode ~= Enum.KeyCode.Escape then State.MenuKey = i.KeyCode.Name end
                M.updateBindBtn()
            end
            return
        end
        if gp then return end
        if i.UserInputType == Enum.UserInputType.Keyboard and i.KeyCode.Name == State.MenuKey then setMenu(not open) end
    end)

    -- config
    local function applyData(data)
        for k, v in pairs(data) do
            if DEFAULTS[k] ~= nil and type(v) == type(DEFAULTS[k]) then
                if Reg[k] then pcall(Reg[k], v) else State[k] = v end
            end
        end
    end
    local function saveCfg()
        if not writefile then logErr("writefile not supported") return end
        local data = {}
        for k, v in pairs(State) do
            local t = type(v)
            if t == "boolean" or t == "number" or t == "string" then data[k] = v end
        end
        local ok = pcall(function() writefile(CONFIG_FILE, HttpService:JSONEncode(data)) end)
        if ok then logOk("Config saved") else logErr("Config save failed") end
    end
    local function loadCfg(silent)
        if not (readfile and isfile) then if not silent then logErr("readfile not supported") end return end
        if not isfile(CONFIG_FILE) then if not silent then logWarn("No config file") end return end
        local ok, data = pcall(function() return HttpService:JSONDecode(readfile(CONFIG_FILE)) end)
        if not ok or type(data) ~= "table" then logErr("Config read failed") return end
        applyData(data)
        logOk("Config loaded")
    end

    local s = section(SetPage, "Menu")
    local bindBtn
    bindBtn = button(s, "", function()
        M.listening = true
        bindBtn.Text = "press a key...  (esc = cancel)"
    end)
    function M.updateBindBtn() bindBtn.Text = "Menu key: " .. State.MenuKey:lower() .. "   [click to change]" end
    Reg.MenuKey = function(v) State.MenuKey = v M.updateBindBtn() end
    M.updateBindBtn()
    toggle(s, "Background blur", "Blur", function(v)
        if open then tween(blur, 0.2, { Size = v and 14 or 0 }) end
    end)

    s = section(SetPage, "Config")
    button(s, "Save config", saveCfg)
    button(s, "Load config", function() loadCfg(false) end)
    button(s, "Reset to defaults", function() applyData(DEFAULTS) logOk("Config reset") end)
    button(s, "Delete config file", function()
        if delfile and isfile and isfile(CONFIG_FILE) then pcall(delfile, CONFIG_FILE) logOk("Config deleted")
        else logWarn("Nothing to delete") end
    end, true)

    s = section(SetPage, "Script")
    button(s, "Unload script", function()
        if _G.AbaddonCleanup then _G.AbaddonCleanup() end
    end, true)

    ------------------------------------------------------------------
    -- boot
    ------------------------------------------------------------------
    task.spawn(function()
        task.wait(0.3)
        pcall(loadCfg, true)
        setMenu(true)
        logOk("abaddon hvh loaded  |  " .. State.MenuKey .. " = menu")
    end)
end
