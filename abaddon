do -- accessories (клиентские, видны только тебе)
    local objs, anim, animConn = {}, nil, nil
    local function clear()
        for _, o in ipairs(objs) do pcall(function() o:Destroy() end) end
        objs, anim = {}, nil
    end
    local function part(name, size, shape, col)
        local p = new("Part", {
            Name = name, Size = size, Shape = shape or Enum.PartType.Block, Material = Enum.Material.Neon, Color = col,
            CanCollide = false, CanQuery = false, CanTouch = false, Massless = true, CastShadow = false,
        })
        objs[#objs + 1] = p
        return p
    end
    local function weld(p, to, c0)
        local w = new("Weld", { Part0 = to, Part1 = p, C0 = c0 }, p)
        p.Parent = to.Parent
        return w
    end

    local function build()
        clear()
        local kind = State.Accessory
        if kind == "None" then return end
        local ch = LP.Character
        if not ch then return end
        local head, torso, root = ch:FindFirstChild("Head"), ch:FindFirstChild("Torso"), ch:FindFirstChild("HumanoidRootPart")
        local col = colorOf(State.AccessoryColor)

        if kind == "Halo" and head then
            local p = part("Halo", Vector3.new(0.15, 2.2, 2.2), Enum.PartType.Cylinder, col)
            local w = weld(p, head, CFrame.new(0, 1.1, 0) * CFrame.Angles(0, 0, math.rad(90)))
            anim = function(t) w.C0 = CFrame.new(0, 1.1 + math.sin(t * 2) * 0.08, 0) * CFrame.Angles(0, 0, math.rad(90)) end
        elseif kind == "Crown" and head then
            local ws = {}
            for i = 1, 6 do
                local p = part("Crown", Vector3.new(0.25, 0.7, 0.25), nil, col)
                ws[i] = weld(p, head, CFrame.new())
            end
            anim = function(t)
                for i, w in ipairs(ws) do
                    local a = (i / 6) * math.pi * 2 + t
                    w.C0 = CFrame.new(math.cos(a) * 0.55, 0.85, math.sin(a) * 0.55) * CFrame.Angles(0, -a, 0)
                end
            end
        elseif kind == "Wings" and torso then
            local feathers = {}
            local lens = { 2.8, 2.3, 1.8 }
            for side = -1, 1, 2 do
                for i, len in ipairs(lens) do
                    local p = part("Wing", Vector3.new(0.12, len, 0.5), nil, col)
                    feathers[#feathers + 1] = { w = weld(p, torso, CFrame.new()), side = side, i = i, len = len }
                end
            end
            anim = function(t)
                local flap = math.sin(t * 4) * 12
                for _, f in ipairs(feathers) do
                    f.w.C0 = CFrame.new(f.side * 0.9, 0.4, 0.6)
                        * CFrame.Angles(0, f.side * math.rad(-35 - flap), f.side * math.rad(-(25 + f.i * 20)))
                        * CFrame.new(0, f.len / 2, 0)
                end
            end
        elseif kind == "Aura" and root then
            local e = new("ParticleEmitter", {
                Rate = 40, Lifetime = NumberRange.new(0.8, 1.2), Speed = NumberRange.new(2, 4), SpreadAngle = Vector2.new(180, 180),
                Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0) }),
                Color = ColorSequence.new(col), LightEmission = 1,
                Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 1) }),
            }, root)
            objs[#objs + 1] = e
        elseif kind == "Trail" and torso then
            local a0 = new("Attachment", { Position = Vector3.new(0, 1, 0) }, torso)
            local a1 = new("Attachment", { Position = Vector3.new(0, -1, 0) }, torso)
            local tr = new("Trail", {
                Attachment0 = a0, Attachment1 = a1, Lifetime = 0.6, Color = ColorSequence.new(col), LightEmission = 1,
                Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) }),
            }, torso)
            objs[#objs + 1], objs[#objs + 2], objs[#objs + 3] = a0, a1, tr
        end
    end
    M.buildAccessory = build

    hook(RunService.RenderStepped, function()
        if anim then anim(os.clock()) end
    end)
    hook(LP.CharacterAdded, function() task.wait(0.6) build() end)
    onCleanup(clear)
end

