do -- remote logger + переписывание fire-ремоутов
    local NAMES = { CheckFire = true, ProjectileRender = true, CheckShot = true, ProjectileFinished = true, GunShot = true }
    local REWRITE = { CheckFire = true, ProjectileRender = true }
    local function fmt(v)
        local t = typeof(v)
        if t == "string" then return '"' .. v:sub(1, 24) .. '"' end
        if t == "Instance" then return v.ClassName .. ":" .. v.Name end
        if t == "number" then return string.format("%.3g", v) end
        return t .. ":" .. tostring(v):sub(1, 24)
    end

    _G.AbaddonRL = nil   -- хук старой версии вызывает _G.AbaddonRL, отключаем его
    _G.AbaddonRW = function(self, ...)
        if not alive or typeof(self) ~= "Instance" then return nil end
        local name = self.Name
        if not NAMES[name] then return nil end
        local a = table.pack(...)
        local rewritten = false
        if REWRITE[name] and State.RageOn and State.RageRewrite and State.RageMode ~= "Camera" then
            local ok, ch = pcall(M.rewriteArgs, a)
            rewritten = ok and ch or false
        end
        if State.RemoteLog then
            local out = {}
            for i = 1, math.min(a.n, 8) do out[i] = fmt(a[i]) end
            local line = name .. "(" .. table.concat(out, ", ") .. ")" .. (rewritten and " [rewritten]" or "")
            task.defer(function()
                print("[remote] " .. line)
                log(line, rgb(150, 170, 255))
            end)
        end
        if rewritten then return a end
        return nil
    end
    onCleanup(function() _G.AbaddonRW = nil end)

    M.remoteHookOk = hookmetamethod ~= nil and getnamecallmethod ~= nil
    if M.remoteHookOk and _G.AbaddonRLHookV ~= 2 then
        _G.AbaddonRLHookV = 2
        local old
        local function f(self, ...)
            local m = getnamecallmethod()
            if m == "FireServer" and _G.AbaddonRW and not (checkcaller and checkcaller()) then
                local ok, res = pcall(_G.AbaddonRW, self, ...)
                if setnamecallmethod then setnamecallmethod(m) end
                if ok and res then return old(self, table.unpack(res, 1, res.n)) end
            end
            return old(self, ...)
        end
        old = hookmetamethod(game, "__namecall", newcclosure and newcclosure(f) or f)
    end
end

local function rejoin() TeleportService:Teleport(game.PlaceId, LP) end
local function serverHop()
    local ok, res = pcall(function()
        return HttpService:JSONDecode(game:HttpGet(("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100"):format(game.PlaceId)))
    end)
    if not ok or not res or not res.data then logErr("Server hop: request failed") return end
    local list = {}
    for _, s in ipairs(res.data) do
        if s.playing < s.maxPlayers and s.id ~= game.JobId then list[#list + 1] = s.id end
    end
    if #list == 0 then logWarn("Server hop: no free servers") return end
    TeleportService:TeleportToPlaceInstance(game.PlaceId, list[math.random(#list)], LP)
end

