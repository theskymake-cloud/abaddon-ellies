do
    local orig, atm = {}, {}
    M.flash = 0
    hook(RunService.Heartbeat, function(dt)
        M.flash = math.max(0, M.flash - dt * 2.5)
        local d = {}
        if State.CustomTime then d.ClockTime = State.ClockTime end
        if State.Nighttime then
            d.ClockTime = 0
            d.Ambient, d.OutdoorAmbient, d.Brightness = rgb(28, 32, 58), rgb(28, 32, 58), 0.6
        end
        if State.Weather == "Storm" then
            d.Ambient = d.Ambient or rgb(60, 64, 76)
            d.OutdoorAmbient = d.OutdoorAmbient or rgb(60, 64, 76)
            d.Brightness = 1
        end
        if State.AmbientOn then
            local col = colorOf(State.AmbientColor)
            d.Ambient, d.OutdoorAmbient = col, col
        end
        if State.Fullbright then
            d.Ambient, d.OutdoorAmbient = rgb(200, 200, 200), rgb(200, 200, 200)
            d.Brightness, d.ExposureCompensation = 2.5, 0.3
        end
        if State.NoShadows then d.GlobalShadows = false end
        if State.NoFog then d.FogEnd, d.FogStart = 1e6, 1e6 end
        if M.flash > 0 then
            local base = d.ExposureCompensation or orig.ExposureCompensation or Lighting.ExposureCompensation
            d.ExposureCompensation = base + M.flash * 2
        end
        for prop, val in pairs(d) do
            if orig[prop] == nil then orig[prop] = Lighting[prop] end
            if Lighting[prop] ~= val then Lighting[prop] = val end
        end
        for prop, o in pairs(orig) do
            if d[prop] == nil then Lighting[prop] = o orig[prop] = nil end
        end
        for _, a in ipairs(Lighting:GetChildren()) do
            if a:IsA("Atmosphere") then
                if State.NoFog then
                    if not atm[a] then atm[a] = { a.Density, a.Haze } end
                    a.Density, a.Haze = 0, 0
                elseif atm[a] then
                    a.Density, a.Haze = atm[a][1], atm[a][2]
                    atm[a] = nil
                end
            end
        end
    end)
    onCleanup(function()
        for prop, o in pairs(orig) do pcall(function() Lighting[prop] = o end) end
        for a, v in pairs(atm) do pcall(function() a.Density, a.Haze = v[1], v[2] end) end
    end)
end

do
